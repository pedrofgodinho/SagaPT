LANGCHAIN_API_KEY=""

# Google Cloud / Vertex AI Application Default Credentials — machine-local
# absolute path to the file generated by `gcloud auth application-default login`.
# Default locations:
#   Windows: %APPDATA%\gcloud\application_default_credentials.json
#   macOS/Linux: ~/.config/gcloud/application_default_credentials.json
# On Windows, use SINGLE quotes, not double — python-dotenv processes C-style
# backslash escapes inside double-quoted values (e.g. \a becomes a literal
# bell character), which silently corrupts a Windows path like
# ...\gcloud\application_default_credentials.json (the \a in "gcloud\application"
# gets eaten). Single-quoted values are taken literally, no escaping.
GOOGLE_APPLICATION_CREDENTIALS=''
