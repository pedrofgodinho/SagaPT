# Saga Environment Variables
LOG_LEVEL = "INFO"

# Maximum concurrent runs the API server will execute at once. Extra
# POST /api/v1/runs are queued as PENDING (visible on the frontend + SSE)
# until a slot frees. Each concurrent run spawns its own ephemeral ZAP
# container, so raising this uses proportionally more memory/CPU.
SAGA_MAX_CONCURRENT_RUNS = 1

# LLM retry / rate-limit knobs. Two runs starting near-simultaneously
# burst LLM traffic and can trip Vertex AI's per-minute quota (429
# RESOURCE_EXHAUSTED). SAGA_LLM_MAX_RETRIES enables SDK-level exponential
# backoff on transient errors (default 6, usually enough to absorb a
# burst). SAGA_LLM_RPS attaches a shared client-side rate limiter per
# model_name when set > 0 (e.g. "2.0" caps that model to 120 req/min
# across ALL concurrent runs) — leave unset/0 unless you're on a strict
# quota tier or still hitting 429s despite retries.
SAGA_LLM_MAX_RETRIES = 6
# SAGA_LLM_RPS = 2.0

# LangSmith
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_PROJECT="thesis-zap-agent"

# Google Cloud / Vertex AI — auth is via Application Default Credentials, not
# an API key. GOOGLE_APPLICATION_CREDENTIALS must point at your own machine's
# ADC JSON (generated by `gcloud auth application-default login`), so it's set
# per-machine in saga.secrets.env (gitignored), not here — see
# saga.secrets.env.example.
GOOGLE_CLOUD_PROJECT=hardy-binder-501115-t8
GOOGLE_CLOUD_LOCATION=global

# Ollama (local models) — only used by sections whose model_provider = "ollama".
# Points Saga at the Ollama daemon; defaults to Ollama's own default when unset.
# Saga runs natively, so localhost reaches an `ollama serve` on the same host.
# OLLAMA_BASE_URL = http://localhost:11434

# llama.cpp (local models via llama-server's OpenAI-compatible API) — only used
# by sections whose model_provider = "llamacpp". Port 8081 (not 8080, which the
# Saga API server uses); start the server with `just llama <hf-model> <ctx>`.
# The API key is a placeholder — llama-server ignores it unless launched with
# --api-key; set LLAMACPP_API_KEY only if you started llama-server with one.
# LLAMACPP_BASE_URL = http://localhost:8081/v1
# LLAMACPP_API_KEY = sk-no-key-required
