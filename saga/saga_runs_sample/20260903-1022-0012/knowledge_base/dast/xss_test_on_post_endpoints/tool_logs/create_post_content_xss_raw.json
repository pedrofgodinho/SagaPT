{"status": 200, "headers": {"Server": "Werkzeug/3.0.6 Python/3.8.10", "Date": "Thu, 03 Sep 2026 10:26:50 GMT", "Content-Type": "text/html; charset=utf-8", "Content-Length": "4772", "Vary": "Cookie", "Connection": "close"}, "body": "<!doctype html>\n<!-- <meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'self'; script-src 'self';\"> -->\n<html>\n    <head>\n        <title>Hackergram - New Post</title>\n        <link rel=\"shortcut icon\" type=\"image/jpg\" href = \"./static/photos/icon.jpg\">\n        <link rel=\"stylesheet\" href=\"/static/css/bootstrap.min.css\">\n        <link rel=\"stylesheet\" href=\"/static/css/main.css\">\n        <script src=\"/static/js/jquery-3.6.4.min.js\"></script>\n        <script src=\"/static/js/bootstrap.min.js\"></script>\n    </head>\n    <header>\n        <nav class=\"navbar fixed-top navbar-expand-lg navbar-dark bg-secondary py-3\">\n            <a class=\"navbar-brand\" href=\"/\">\n                <img src=\"./static/photos/icon.jpg\" width=\"30\" height=\"30\"> Hackergram\n            </a>\n            <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-target=\"#navbarNav\" aria-controls=\"navbarNav\" aria-expanded=\"false\" aria-label=\"Toggle navigation\">\n                <span class=\"navbar-toggler-icon\"></span>\n            </button>\n            <div class=\"collapse navbar-collapse\" id=\"navbarNav\">\n                <div class=\"ml-auto\">\n                    <ul class=\"navbar-nav\">\n                        \n                            <div type=\"hidden\" id=\"user\" value=\"mr_robot\"></div>\n                            <li class=\"nav-item\"><a class=\"nav-link\" href=\"/create_post\">New Post</a></li>\n                            <li class=\"nav-item\"><a class=\"nav-link\" href=\"/requests\">Requests</a></li>\n                            <li class=\"nav-item dropdown\">\n                                <a class=\"nav-link dropdown-toggle\" data-toggle=\"dropdown\" href=\"#\" role=\"button\" aria-haspopup=\"true\" aria-expanded=\"false\">Search</a>\n                                <div class=\"dropdown-menu\">\n                                    <a class=\"dropdown-item\" href=\"/users\">Search Users</a>\n                                    <a class=\"dropdown-item\" href=\"/posts\">Search Posts</a>\n                                    <a class=\"dropdown-item\" href=\"/messages\">Search Messages</a>\n                                </div>\n                            </li>\n                            <li class=\"nav-item\"><a class=\"nav-link\" href=\"/profile?username=mr_robot\">My Profile</a></li>\n                            <li class=\"nav-item\"><a class=\"nav-link\" href=\"/settings\">Settings</a></li>\n                            <li class=\"nav-item\"><a class=\"nav-link\" href=\"/logout\">Logout</a></li>\n                        \n                    </ul>\n                </div>\n            </div>\n        </nav>\n    </header>\n\n    <main>\n        <div class=\"container-fluid\">\n            <div class=\"row\">\n                <div class=\"col-sm-6 col-lg-4 mx-auto\"></div>\n                <div class=\"col-sm-6 col-lg-4 mx-auto\">\n                    \n                    <center>\n                        \n                        <hr class=\"half-rule\" color=\"grey\" />\n                    </center>\n                    \n                </div>\n                <div class=\"col-sm-6 col-lg-4 mx-auto\"></div>\n            </div>\n        </div>\n\n        \n<div class=\"container-fluid mt-5\">\n    <div class=\"row justify-content-center mt-5\">\n        <div class=\"col-lg-6\">\n            <div class=\"card shadow\">\n                <div class=\"card-header bg-primary text-white\">\n                    <h4 class=\"mb-0\">Create a new post</h4>\n                </div>\n                <div class=\"card-body\">\n                    <form action=\"/create_post\" method=\"post\">\n                        \n                        \n                        \n                        <div class=\"form-group\">\n                            <label for=\"content\">Post content</label>\n                            <textarea class=\"form-control\" name=\"content\" id=\"content\" rows=\"5\"\n                                      placeholder=\"Write your post here\"></textarea>\n                        </div>\n                        <div class=\"text-center mt-3\">\n                            <button type=\"submit\" class=\"btn btn-primary\">Create</button>\n                        </div>\n                    </form>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n\n<script>\n    document.addEventListener('DOMContentLoaded', () => {\n        const urlParams = new URLSearchParams(window.location.search); \n        const content = urlParams.get('content');\n        if (content) {\n            document.getElementById('content').value = content;\n        }\n    });\n</script>\n\n    </main>\n\n    <footer class=\"footer fixed-bottom bg-light\">\n        <div>\n            <center>\n                <span class=\"text-muted\">Hackergram. Developed for a Master's Dissertation @ IST.</span>\n            </center>\n        </div>\n    </footer>\n</html>", "alerts": [{"method": "GET", "evidence": "", "pluginId": "10020", "confidence": "Medium", "url": "http://www.hackergram.com/create_post?content=%22%3E%3Cscript%3Ealert(1)%3C/script%3E", "param": "x-frame-options", "attack": "", "name": "Missing Anti-clickjacking Header", "risk": "Medium"}, {"method": "GET", "evidence": "", "pluginId": "10038", "confidence": "High", "url": "http://www.hackergram.com/create_post?content=%22%3E%3Cscript%3Ealert(1)%3C/script%3E", "param": "", "attack": "", "name": "Content Security Policy (CSP) Header Not Set", "risk": "Medium"}, {"method": "GET", "evidence": "<form action=\"/create_post\" method=\"post\">", "pluginId": "10202", "confidence": "Low", "url": "http://www.hackergram.com/create_post?content=%22%3E%3Cscript%3Ealert(1)%3C/script%3E", "param": "", "attack": "", "name": "Absence of Anti-CSRF Tokens", "risk": "Medium"}, {"method": "GET", "evidence": "<a class=\"nav-link dropdown-toggle\" data-toggle=\"dropdown\" href=\"#\" role=\"button\" aria-haspopup=\"true\" aria-expanded=\"false\">Search</a>", "pluginId": "10109", "confidence": "Medium", "url": "http://www.hackergram.com/create_post?content=%22%3E%3Cscript%3Ealert(1)%3C/script%3E", "param": "", "attack": "", "name": "Modern Web Application", "risk": "Informational"}, {"method": "GET", "evidence": "Werkzeug/3.0.6 Python/3.8.10", "pluginId": "10036", "confidence": "High", "url": "http://www.hackergram.com/create_post?content=%22%3E%3Cscript%3Ealert(1)%3C/script%3E", "param": "", "attack": "", "name": "Server Leaks Version Information via \"Server\" HTTP Response Header Field", "risk": "Low"}, {"method": "GET", "evidence": "", "pluginId": "10021", "confidence": "Medium", "url": "http://www.hackergram.com/create_post?content=%22%3E%3Cscript%3Ealert(1)%3C/script%3E", "param": "x-content-type-options", "attack": "", "name": "X-Content-Type-Options Header Missing", "risk": "Low"}], "kb_key": "create_post_content_xss"}